{
  "name": "local-siem-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Signalbay Node.js backend: UDP syslog collector, CISA aggregator, SQLite, and Apple Silicon Metal inference",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test src/*.test.ts",
    "metal": "node-llama-cpp source download --gpu metal"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-llama-cpp": "^3.10.0",
    "sqlite3": "^5.1.7",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/sqlite3": "^3.1.11",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-llama-cpp@3.20.0": true,
    "sqlite3@5.1.7": true
  }
}
